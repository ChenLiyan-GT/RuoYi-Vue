<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.work.mapper.WorkLevelRuleMapper">

	<resultMap type="WorkLevelRule" id="WorkLevelRuleResult">
		<id     property="ruleId"        column="rule_id"       />
		<result property="level"         column="level"         />
		<result property="levelName"     column="level_name"    />
		<result property="minStage"      column="min_stage"     />
		<result property="maxStage"      column="max_stage"     />
		<result property="description"   column="description"   />
		<result property="delFlag"       column="del_flag"      />
		<result property="createBy"      column="create_by"     />
		<result property="createTime"    column="create_time"   />
		<result property="updateBy"      column="update_by"     />
		<result property="updateTime"    column="update_time"   />
		<result property="remark"        column="remark"        />
	</resultMap>
	
	<sql id="selectLevelRuleVo">
        select rule_id, level, level_name, min_stage, max_stage, description, del_flag, create_by, create_time, update_by, update_time, remark 
		from work_level_rule
    </sql>
	
	<select id="selectLevelRuleList" parameterType="WorkLevelRule" resultMap="WorkLevelRuleResult">
	    <include refid="selectLevelRuleVo"/>
		<where>
			<if test="level != null">
				AND level = #{level}
			</if>
			<if test="levelName != null and levelName != ''">
				AND level_name like concat('%', #{levelName}, '%')
			</if>
		</where>
		order by level asc
	</select>
	
	<select id="selectLevelRuleAll" resultMap="WorkLevelRuleResult">
		<include refid="selectLevelRuleVo"/>
		where del_flag = '0'
		order by level asc
	</select>
	
	<select id="selectLevelRuleById" parameterType="Long" resultMap="WorkLevelRuleResult">
		<include refid="selectLevelRuleVo"/>
		where rule_id = #{ruleId}
	</select>
	
	<select id="checkLevelUnique" parameterType="Integer" resultMap="WorkLevelRuleResult">
		<include refid="selectLevelRuleVo"/>
		where level = #{level} limit 1
	</select>
	
 	<update id="deleteLevelRuleByIds" parameterType="Long">
 		update work_level_rule set del_flag = '2' where rule_id in
 		<foreach collection="array" item="ruleId" open="(" separator="," close=")">
 			#{ruleId}
        </foreach>
 	</update>
 	
 	<update id="updateLevelRule" parameterType="WorkLevelRule">
 		update work_level_rule
 		<set>
 			<if test="level != null">level = #{level},</if>
 			<if test="levelName != null and levelName != ''">level_name = #{levelName},</if>
 			<if test="minStage != null and minStage != ''">min_stage = #{minStage},</if>
 			<if test="maxStage != null and maxStage != ''">max_stage = #{maxStage},</if>
 			<if test="description != null">description = #{description},</if>
 			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			<if test="remark != null">remark = #{remark},</if>
 			update_time = sysdate()
 		</set>
 		where rule_id = #{ruleId}
	</update>
 	
 	<insert id="insertLevelRule" parameterType="WorkLevelRule" useGeneratedKeys="true" keyProperty="ruleId">
 		insert into work_level_rule(
 			<if test="ruleId != null and ruleId != 0">rule_id,</if>
 			<if test="level != null">level,</if>
 			<if test="levelName != null and levelName != ''">level_name,</if>
 			<if test="minStage != null and minStage != ''">min_stage,</if>
 			<if test="maxStage != null and maxStage != ''">max_stage,</if>
 			<if test="description != null and description != ''">description,</if>
 			<if test="createBy != null and createBy != ''">create_by,</if>
 			<if test="remark != null and remark != ''">remark,</if>
 			create_time
 		)values(
 			<if test="ruleId != null and ruleId != 0">#{ruleId},</if>
 			<if test="level != null">#{level},</if>
 			<if test="levelName != null and levelName != ''">#{levelName},</if>
 			<if test="minStage != null and minStage != ''">#{minStage},</if>
 			<if test="maxStage != null and maxStage != ''">#{maxStage},</if>
 			<if test="description != null and description != ''">#{description},</if>
 			<if test="createBy != null and createBy != ''">#{createBy},</if>
 			<if test="remark != null and remark != ''">#{remark},</if>
 			sysdate()
 		)
	</insert>

</mapper>