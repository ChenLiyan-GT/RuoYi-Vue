<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.work.mapper.WorkEmployeeMapper">

	<resultMap type="WorkEmployee" id="WorkEmployeeResult">
		<id     property="employeeId"        column="employee_id"       />
		<result property="employeeNo"        column="employee_no"       />
		<result property="employeeName"      column="employee_name"     />
		<result property="deptId"            column="dept_id"           />
		<result property="userId"            column="user_id"           />
		<result property="positionType"      column="position_type"     />
		<result property="positionLevel"     column="position_level"    />
		<result property="skills"            column="skills"            />
		<result property="status"            column="status"            />
		<result property="currentWorkload"   column="current_workload"  />
		<result property="maxWorkload"       column="max_workload"      />
		<result property="delFlag"           column="del_flag"          />
		<result property="createBy"          column="create_by"         />
		<result property="createTime"        column="create_time"       />
		<result property="updateBy"          column="update_by"         />
		<result property="updateTime"        column="update_time"       />
		<result property="remark"            column="remark"            />
	</resultMap>
	
	<sql id="selectEmployeeVo">
        select employee_id, employee_no, employee_name, dept_id, user_id, position_type, 
               position_level, skills, status, current_workload, max_workload, del_flag, 
               create_by, create_time, update_by, update_time, remark 
		from work_employee
    </sql>
	
	<select id="selectEmployeeList" parameterType="WorkEmployee" resultMap="WorkEmployeeResult">
	    <include refid="selectEmployeeVo"/>
		<where>
			<if test="delFlag == null or delFlag == '' or delFlag == '0'">
				AND del_flag = '0'
			</if>
			<if test="employeeNo != null and employeeNo != ''">
				AND employee_no like concat('%', #{employeeNo}, '%')
			</if>
			<if test="employeeName != null and employeeName != ''">
				AND employee_name like concat('%', #{employeeName}, '%')
			</if>
			<if test="deptId != null">
				AND dept_id = #{deptId}
			</if>
			<if test="positionType != null and positionType != ''">
				AND position_type = #{positionType}
			</if>
			<if test="positionLevel != null">
				AND position_level = #{positionLevel}
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
		</where>
	</select>
	
	<select id="selectEmployeeAll" resultMap="WorkEmployeeResult">
		<include refid="selectEmployeeVo"/>
		where del_flag = '0'
	</select>
	
	<select id="selectEmployeeById" parameterType="Long" resultMap="WorkEmployeeResult">
		<include refid="selectEmployeeVo"/>
		where employee_id = #{employeeId} and del_flag = '0'
	</select>
	
	<select id="checkEmployeeNoUnique" parameterType="String" resultMap="WorkEmployeeResult">
		<include refid="selectEmployeeVo"/>
		where employee_no = #{employeeNo} and del_flag = '0' limit 1
	</select>
	
	<select id="selectEmployeesByDeptId" parameterType="Long" resultMap="WorkEmployeeResult">
		<include refid="selectEmployeeVo"/>
		where dept_id = #{deptId} and del_flag = '0'
	</select>
	
	<select id="selectEmployeesByPosition" resultMap="WorkEmployeeResult">
		<include refid="selectEmployeeVo"/>
		where position_type = #{param1} and position_level >= #{param2} and del_flag = '0'
	</select>
	
	<select id="selectIdleEmployees" resultMap="WorkEmployeeResult">
		<include refid="selectEmployeeVo"/>
		where del_flag = '0' and status = '0'
		<if test="param1 != null and param1 != ''">
			AND position_type = #{param1}
		</if>
		<if test="param2 != null">
			AND position_level >= #{param2}
		</if>
		order by current_workload asc
	</select>
	
 	<delete id="deleteEmployeeByIds" parameterType="Long">
 		update work_employee set del_flag = '2' where employee_id in
 		<foreach collection="array" item="employeeId" open="(" separator="," close=")">
 			#{employeeId}
        </foreach>
 	</delete>
 	
 	<update id="updateEmployee" parameterType="WorkEmployee">
 		update work_employee
 		<set>
 			<if test="employeeNo != null and employeeNo != ''">employee_no = #{employeeNo},</if>
 			<if test="employeeName != null and employeeName != ''">employee_name = #{employeeName},</if>
 			<if test="deptId != null">dept_id = #{deptId},</if>
 			<if test="userId != null">user_id = #{userId},</if>
 			<if test="positionType != null and positionType != ''">position_type = #{positionType},</if>
 			<if test="positionLevel != null">position_level = #{positionLevel},</if>
 			<if test="skills != null">skills = #{skills},</if>
 			<if test="status != null and status != ''">status = #{status},</if>
 			<if test="currentWorkload != null">current_workload = #{currentWorkload},</if>
 			<if test="maxWorkload != null">max_workload = #{maxWorkload},</if>
 			<if test="remark != null">remark = #{remark},</if>
 			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			update_time = sysdate()
 		</set>
 		where employee_id = #{employeeId}
	</update>
	
	<update id="updateEmployeeWorkload" parameterType="WorkEmployee">
		update work_employee
		set current_workload = #{currentWorkload},
		    status = #{status},
		    update_time = sysdate()
		where employee_id = #{employeeId}
	</update>
 	
 	<insert id="insertEmployee" parameterType="WorkEmployee" useGeneratedKeys="true" keyProperty="employeeId">
 		insert into work_employee(
 			<if test="employeeId != null and employeeId != 0">employee_id,</if>
 			<if test="employeeNo != null and employeeNo != ''">employee_no,</if>
 			<if test="employeeName != null and employeeName != ''">employee_name,</if>
 			<if test="deptId != null">dept_id,</if>
 			<if test="userId != null">user_id,</if>
 			<if test="positionType != null and positionType != ''">position_type,</if>
 			<if test="positionLevel != null">position_level,</if>
 			<if test="skills != null and skills != ''">skills,</if>
 			<if test="status != null and status != ''">status,</if>
 			<if test="currentWorkload != null">current_workload,</if>
 			<if test="maxWorkload != null">max_workload,</if>
 			<if test="remark != null and remark != ''">remark,</if>
 			<if test="createBy != null and createBy != ''">create_by,</if>
 			create_time
 		)values(
 			<if test="employeeId != null and employeeId != 0">#{employeeId},</if>
 			<if test="employeeNo != null and employeeNo != ''">#{employeeNo},</if>
 			<if test="employeeName != null and employeeName != ''">#{employeeName},</if>
 			<if test="deptId != null">#{deptId},</if>
 			<if test="userId != null">#{userId},</if>
 			<if test="positionType != null and positionType != ''">#{positionType},</if>
 			<if test="positionLevel != null">#{positionLevel},</if>
 			<if test="skills != null and skills != ''">#{skills},</if>
 			<if test="status != null and status != ''">#{status},</if>
 			<if test="currentWorkload != null">#{currentWorkload},</if>
 			<if test="maxWorkload != null">#{maxWorkload},</if>
 			<if test="remark != null and remark != ''">#{remark},</if>
 			<if test="createBy != null and createBy != ''">#{createBy},</if>
 			sysdate()
 		)
	</insert>

</mapper>