<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.work.mapper.WorkAssignmentMapper">

	<resultMap type="WorkAssignment" id="WorkAssignmentResult">
		<id     property="assignId"        column="assign_id"         />
		<result property="jobStageId"      column="job_stage_id"      />
		<result property="employeeId"      column="employee_id"       />
		<result property="workload"        column="workload"          />
		<result property="status"          column="status"            />
		<result property="assignBy"        column="assign_by"         />
		<result property="assignTime"      column="assign_time"       />
		<result property="completeTime"    column="complete_time"     />
		<result property="createBy"        column="create_by"         />
		<result property="createTime"      column="create_time"       />
		<result property="updateBy"        column="update_by"         />
		<result property="updateTime"      column="update_time"       />
		<result property="remark"          column="remark"            />
		<result property="delFlag"         column="del_flag"          />
	</resultMap>
	
	<sql id="selectAssignmentVo">
        select assign_id, job_stage_id, employee_id, workload, status, 
               assign_by, assign_time, complete_time,
               create_by, create_time, update_by, update_time, remark, del_flag 
		from work_assignment
    </sql>
	
	<select id="selectAssignmentList" parameterType="WorkAssignment" resultMap="WorkAssignmentResult">
	    <include refid="selectAssignmentVo"/>
		<where>
			<if test="delFlag == null or delFlag == '' or delFlag == '0'">
				AND del_flag = '0'
			</if>
			<if test="jobStageId != null">
				AND job_stage_id = #{jobStageId}
			</if>
			<if test="employeeId != null">
				AND employee_id = #{employeeId}
			</if>
			<if test="status != null and status != ''">
				AND status = #{status}
			</if>
			<if test="assignBy != null and assignBy != ''">
				AND assign_by = #{assignBy}
			</if>
		</where>
		order by assign_time desc
	</select>
	
	<select id="selectAssignmentsByJobStageId" parameterType="Long" resultMap="WorkAssignmentResult">
		<include refid="selectAssignmentVo"/>
		where job_stage_id = #{jobStageId} and del_flag = '0'
		order by assign_time desc
	</select>
	
	<select id="selectAssignmentsByEmployeeId" parameterType="Long" resultMap="WorkAssignmentResult">
		<include refid="selectAssignmentVo"/>
		where employee_id = #{employeeId} and del_flag = '0'
		order by assign_time desc
	</select>
	
	<select id="selectAssignmentById" parameterType="Long" resultMap="WorkAssignmentResult">
		<include refid="selectAssignmentVo"/>
		where assign_id = #{assignId} and del_flag = '0'
	</select>
	
	<select id="selectPendingAssignments" parameterType="Long" resultMap="WorkAssignmentResult">
		<include refid="selectAssignmentVo"/>
		where employee_id = #{param1} and status = '0' and del_flag = '0'
		order by assign_time asc
	</select>
	
 	<delete id="deleteAssignmentByIds" parameterType="Long">
 		update work_assignment set del_flag = '2' where assign_id in
 		<foreach collection="array" item="assignId" open="(" separator="," close=")">
 			#{assignId}
        </foreach>
 	</delete>
 	
 	<delete id="deleteAssignmentsByJobStageId" parameterType="Long">
 		update work_assignment set del_flag = '2' where job_stage_id = #{jobStageId}
 	</delete>
 	
 	<update id="updateAssignment" parameterType="WorkAssignment">
 		update work_assignment
 		<set>
 			<if test="jobStageId != null">job_stage_id = #{jobStageId},</if>
 			<if test="employeeId != null">employee_id = #{employeeId},</if>
 			<if test="workload != null">workload = #{workload},</if>
 			<if test="status != null and status != ''">status = #{status},</if>
 			<if test="assignBy != null and assignBy != ''">assign_by = #{assignBy},</if>
 			<if test="assignTime != null">assign_time = #{assignTime},</if>
 			<if test="completeTime != null">complete_time = #{completeTime},</if>
 			<if test="remark != null">remark = #{remark},</if>
 			<if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
 			update_time = sysdate()
 		</set>
 		where assign_id = #{assignId}
	</update>
	
	<update id="updateAssignmentStatus">
		update work_assignment 
		set status = #{param2}, update_time = sysdate()
		<if test="param2 == '2'">
			, complete_time = curdate()
		</if>
		where assign_id = #{param1}
	</update>
 	
 	<insert id="insertAssignment" parameterType="WorkAssignment" useGeneratedKeys="true" keyProperty="assignId">
 		insert into work_assignment(
 			<if test="assignId != null and assignId != 0">assign_id,</if>
 			<if test="jobStageId != null">job_stage_id,</if>
 			<if test="employeeId != null">employee_id,</if>
 			<if test="workload != null">workload,</if>
 			<if test="status != null and status != ''">status,</if>
 			<if test="assignBy != null and assignBy != ''">assign_by,</if>
 			<if test="remark != null and remark != ''">remark,</if>
 			<if test="createBy != null and createBy != ''">create_by,</if>
 			create_time
 		)values(
 			<if test="assignId != null and assignId != 0">#{assignId},</if>
 			<if test="jobStageId != null">#{jobStageId},</if>
 			<if test="employeeId != null">#{employeeId},</if>
 			<if test="workload != null">#{workload},</if>
 			<if test="status != null and status != ''">#{status},</if>
 			<if test="assignBy != null and assignBy != ''">#{assignBy},</if>
 			<if test="remark != null and remark != ''">#{remark},</if>
 			<if test="createBy != null and createBy != ''">#{createBy},</if>
 			sysdate()
 		)
	</insert>
	
	<select id="sumEmployeeWorkload" parameterType="Long" resultType="java.lang.Double">
		select coalesce(sum(workload), 0) from work_assignment 
		where employee_id = #{employeeId} and del_flag = '0' and status in ('0', '1')
	</select>
	
	<select id="sumEmployeeCompletedWorkload" parameterType="Long" resultType="java.lang.Double">
		select coalesce(sum(workload), 0) from work_assignment 
		where employee_id = #{employeeId} and del_flag = '0' and status = '2'
	</select>

</mapper>